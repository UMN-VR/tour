{
  "name": "@umn-vr/tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The University of Minnesota's virtual campus tours, Minneapolis, Saint Paul and Twin Cities, as apps built on FOSS Earth.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "npm run check:heights && npm run typecheck && vite build --configLoader native",
    "deploy": "node tools/deploy.mjs",
    "preview": "vite preview --configLoader native",
    "campus-scenes": "node tools/campus-scenes.mjs",
    "build:scene": "node tools/twin-cities/build-scene.mjs",
    "ci": "npm run lint && npm run test && npm run build",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc -p tsconfig.app.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.app.tsbuildinfo && tsc -p tsconfig.node.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.node.tsbuildinfo && tsc -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.test.tsbuildinfo",
    "test": "vitest run --configLoader native --maxWorkers=50%",
    "test:changed": "vitest related --run --configLoader native --maxWorkers=50%",
    "prepare:heights": "node tools/twin-cities/prepare-heights.mjs",
    "check:heights": "node tools/twin-cities/prepare-heights.mjs --check"
  },
  "dependencies": {
    "@foss-earth/engine": "file:../../foss-earth/engine",
    "@foss-earth/ui": "file:../../foss-earth/ui",
    "@babylonjs/core": "8.56.2",
    "@babylonjs/loaders": "8.56.2",
    "@umn-vr/minneapolis": "file:../minneapolis",
    "@umn-vr/st-paul": "file:../st-paul",
    "@umn-vr/twin-cities": "file:../twin-cities",
    "3d-tiles-renderer": "0.4.24",
    "foss-earth": "file:../../foss-earth/app",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.12.4",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.4",
    "vitest": "4.1.6"
  }
}
